@echo off
chcp 65001 >nul
setlocal EnableDelayedExpansion

:: Tao Session ID
set "SESSION_ID=%RANDOM%%RANDOM%"
set "TOOLKIT_SESSION_ID=%SESSION_ID%"
set "WINTITLE=Toolkit Da Dung Cho Windows [%SESSION_ID%] - Phat trien boi Mr.Hai"

:: 1. Kiem tra quyen Admin va tu dong yeu cau UAC
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo Dang yeu cau quyen Administrator...
    powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

title %WINTITLE%
color 0B
cls

:: 2. Chay code PowerShell truc tiep thong qua Base64 (Dang tin cay 100%)
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

:: 3. Don dep cac file tam cua phan mem
del /f /q "%temp%\ToolkitCore_%SESSION_ID%.ps1" >nul 2>&1
for %%P in (PrinterFixTool UC20 CanchinhOffice HardwareTest 1398) do del /f /q "%temp%\%%P_*.exe" >nul 2>&1

:: 4. Xoa sach man hinh va tu dong dong
cls
exit /b
