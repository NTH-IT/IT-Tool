@echo off
setlocal EnableDelayedExpansion
set "SESSION_ID=%RANDOM%%RANDOM%"
set "WINTITLE=Toolkit Windows [%SESSION_ID%] - Phat trien boi Mr.Hai"
net session >nul 2>&1
if %errorlevel% neq 0 (
    set "TOOLKIT_SESSION_ID=%SESSION_ID%"
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit
)
title %WINTITLE%
color 0B
set "TOOLKIT_SESSION_ID=%SESSION_ID%"
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
:: Dọn dẹp các file tạm của phần mềm
del /f /q "%temp%\ToolkitCore_%SESSION_ID%.ps1" >nul 2>&1
for %%P in (PrinterFixTool UC20 CanchinhOffice HardwareTest 1398) do del /f /q "%temp%\%%P_*.exe" >nul 2>&1

:: Xóa sạch toàn bộ nội dung đã hiển thị trên màn hình
cls

:: Tự xóa file launcher.cmd tạm và đóng ngay cửa sổ CMD
(goto) 2>nul & del /f /q "%~f0" & exit
